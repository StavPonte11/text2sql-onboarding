DATABASE_URL=postgresql://postgres:postgres@localhost:5432/text2sql
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
CORS_ORIGINS=["http://localhost:5173"]
APP_ENV=development

# Trino connection
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=trino
TRINO_PASSWORD=
TRINO_CATALOG=hive
TRINO_SCHEMA=default
TRINO_HTTP_SCHEME=http
TRINO_REQUEST_TIMEOUT=30.0
TRINO_ENABLED=true

# Langfuse run-item finalization wait
# Increase LANGFUSE_WAIT_MAX_ATTEMPTS on slow private-network deployments
# where Langfuse takes longer to persist evaluation run items server-side.
# Total max wait ≈ initial_delay × (backoff_factor^max_attempts − 1) / (backoff_factor − 1)
LANGFUSE_WAIT_MAX_ATTEMPTS=20
LANGFUSE_WAIT_INITIAL_DELAY_SECS=0.5
LANGFUSE_WAIT_BACKOFF_FACTOR=1.5
